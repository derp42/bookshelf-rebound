{
  "name": "bookshelf-rebound",
  "version": "2.0.0-rc.1",
  "description": "A maintained, drop-in continuation of the Bookshelf.js ORM for modern Node.js and Knex",
  "main": "bookshelf.js",
  "type": "commonjs",
  "files": [
    "bookshelf.js",
    "lib/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "GOVERNANCE.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "format": "prettier --write \"{lib,scripts,test}/**/*.js\"",
    "format:check": "prettier --check \"{lib,scripts,test}/**/*.js\"",
    "lint": "eslint bookshelf.js lib/",
    "cover": "npm run lint && nyc mocha --check-leaks -t 10000 -b test/index.js",
    "test": "npm run lint && mocha --check-leaks -t 10000 -b test/index.js",
    "test:unit": "mocha --check-leaks -t 10000 -b test/unit-index.js",
    "prepublishOnly": "npm test"
  },
  "homepage": "https://github.com/derp42/bookshelf-rebound#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derp42/bookshelf-rebound.git"
  },
  "bugs": {
    "url": "https://github.com/derp42/bookshelf-rebound/issues"
  },
  "keywords": [
    "bookshelf",
    "bookshelf.js",
    "bookshelf-rebound",
    "drop-in replacement",
    "orm",
    "knex",
    "mysql",
    "postgresql",
    "sqlite",
    "datamapper",
    "active record"
  ],
  "dependencies": {
    "bluebird": "^3.7.2",
    "create-error": "~0.3.1",
    "inflection": "^3.0.2",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "chai": "^6.2.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "knex": "2.5.1",
    "mocha": "^12.0.0",
    "mysql": "^2.18.1",
    "nyc": "^18.0.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "sqlite3": "6.0.1",
    "uuid": "^14.0.1"
  },
  "peerDependencies": {
    "knex": ">=2.5.1 <3.0.0"
  },
  "author": {
    "name": "Tim Griesser",
    "url": "https://github.com/tgriesser"
  },
  "contributors": [
    {
      "name": "Edward Greve",
      "url": "https://github.com/anyong"
    },
    {
      "name": "Rhys van der Waerden",
      "url": "https://github.com/rhys-vdw"
    },
    {
      "name": "Ricardo Graça",
      "url": "https://github.com/ricardograca"
    }
  ],
  "maintainers": [
    {
      "name": "derp42",
      "url": "https://github.com/derp42"
    }
  ],
  "license": "MIT",
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22"
  }
}
